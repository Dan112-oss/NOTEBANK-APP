# Copy this file to .env and fill in real values.
# .env is never committed and is excluded from the web root by .htaccess.

APP_NAME="Note Bank"
APP_ENV=local
# APP_ENV=production disables error display and enforces secure cookies.
APP_URL=http://localhost/notebank
APP_KEY=change-this-to-a-random-64-character-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=notebank
DB_USER=root
DB_PASS=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@notebank.test
SMTP_FROM_NAME="Note Bank"

# Not needed for a normal setup — preview/download watermarking uses a
# pure-PHP pipeline (FPDI + TCPDF, pre-vendored in vendor/) by default,
# with no shell commands, which is also what makes this app deployable
# to hosts like InfinityFree. These two settings only matter as a
# fallback, if that pipeline is ever unavailable and the app falls back
# to shelling out to poppler-utils' pdftoppm/pdfinfo to rasterize PDF
# pages instead. Leave blank to auto-detect on PATH (checked with
# `where` on Windows, `command -v` elsewhere). On Windows/XAMPP, if you
# didn't add poppler's bin folder to PATH, set these to the full .exe
# path instead, e.g.:
#   PDFTOPPM_BIN=C:\poppler\Library\bin\pdftoppm.exe
#   PDFINFO_BIN=C:\poppler\Library\bin\pdfinfo.exe
PDFTOPPM_BIN=
PDFINFO_BIN=
